{
  "name": "raptor-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:local": "npm run build:local --workspace=apps/web",
    "deploy:pi": "npm run build:local --workspace=apps/web && ./apps/web/scripts/deploy-to-pi.sh",
    "lint": "npm run lint --workspace=apps/web",
    "clean": "rm -rf apps/*/node_modules packages/*/node_modules node_modules apps/*/.next apps/*/out"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "lucide-react-native": "^0.563.0"
  }
}
